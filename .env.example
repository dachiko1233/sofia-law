# ---------------------------------------------------------------------------
# Polykarpou Law — backend configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Port the Gin server listens on
PORT=8080

# --- Email (Resend — https://resend.com) -----------------------------------
# API key from the Resend dashboard (Settings → API Keys). Never hard-code it.
RESEND_API_KEY=re_your_api_key_here

# "From" address for outgoing mail.
#  - While your domain is NOT verified in Resend, use the shared test sender:
MAIL_FROM=onboarding@resend.dev
#  - After you verify your own domain in Resend, switch to e.g.:
#    MAIL_FROM=no-reply@yourdomain.com.cy

# The inbox that receives contact enquiries (your own address).
# Note: until your domain is verified, Resend only delivers to THIS address.
MAIL_TO=you@example.com

# Set to true ONLY after you have verified your sending domain in Resend.
# While false, the visitor "thank you" confirmation email is skipped (Resend
# would otherwise refuse to deliver it to other addresses).
DOMAIN_VERIFIED=false

# --- Other ------------------------------------------------------------------
# CORS: the exact origin of the frontend (no trailing slash).
# In local dev with the Vite proxy this is the Vite dev server.
ALLOWED_ORIGIN=http://localhost:5173

# Path to the SQLite database file for newsletter subscribers.
DB_PATH=./data/polykarpou.db
