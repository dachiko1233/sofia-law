# ---------------------------------------------------------------------------
# Polykarpou Law — backend configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Port the Gin server listens on
PORT=8080

# SMTP server used to send the contact enquiry and the client confirmation.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# "From" address for outgoing mail and the office inbox that receives enquiries.
MAIL_FROM=no-reply@domain.com.cy
MAIL_TO=office@domain.com.cy

# CORS: the exact origin of the frontend (no trailing slash).
# In local dev with the Vite proxy this is the Vite dev server.
ALLOWED_ORIGIN=http://localhost:5173

# Path to the SQLite database file for newsletter subscribers.
DB_PATH=./data/polykarpou.db
